# ── Martin configuration ────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ── Models (LiteLLM model strings) ──────────────────────────────────────────
# Default "brain" model — the main reasoning/conversation model.
# Use the LiteLLM "ollama/<tag>" form. Confirm the tag with `ollama list`.
DEFAULT_MODEL=ollama/qwen3:14b

# Fast model — used for cheap intent routing & memory classification so the
# main model stays free for real work.
FAST_MODEL=ollama/mistral:7b

# Where Ollama is listening. Native Windows install defaults to this.
OLLAMA_BASE_URL=http://localhost:11434

# ── Memory (ChromaDB, embedded) ─────────────────────────────────────────────
# Folder where ChromaDB persists memories. Gitignored.
CHROMA_DIR=./data/chroma

# ── Web search ──────────────────────────────────────────────────────────────
# Brave Search API key (free tier: 2,000 queries/month). Leave blank to use
# DuckDuckGo only. Get one at https://brave.com/search/api/
BRAVE_API_KEY=

# ── SEC EDGAR ───────────────────────────────────────────────────────────────
# SEC requires a descriptive User-Agent with a contact email on every EDGAR
# request (used by the tokenized_equity skill). No API key needed.
SEC_USER_AGENT=Martin personal research tool you@example.com

# ── Pillars ─────────────────────────────────────────────────────────────────
# Organizational tags for memory. Comma-separated. Extensible.
PILLARS=business,personal,automation
